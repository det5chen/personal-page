<?xml version="1.0" encoding="UTF-8"?>
<WorkBook xmlVersion="20211223" releaseVersion="11.0.0">
<TableDataMap>
<TableData name="费用明细" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="预算年份"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=YEAR(TODAY())]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="科目大类"/>
<O>
<![CDATA[]]></O>
</Parameter>
<Parameter>
<Attributes name="部门"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 科目大类, 科目类别, 预算年份, 部门, 
SUM(实际费用) - SUM(预算费用) AS 费用预算差异,
cast((SUM(实际费用) * 0.5 - SUM(预算费用) * 0.5) / (SUM(预算费用) * 0.5) as decimal(15,4)) AS 费用超预算比例
FROM (
    SELECT T1.实际费用, T1.预算费用, T2.预算年份, T2.部门, T3.科目类别, T3.科目大类 
    FROM FD_费用预算明细 T1
    INNER JOIN FD_费用科目表 T3 ON T1.科目代码 = T3.科目代码
    INNER JOIN (
        SELECT 预算流程ID, 预算年份, 部门 
        FROM FD_费用预算流转表 
        WHERE 预算年份 = '${预算年份}' AND 状态 = '结束'
    ) T2 ON T1.预算流程ID = T2.预算流程ID
) TT 
WHERE 1=1 
${if(len(科目大类) == 0,"","and 科目大类 = '" + 科目大类 + "'")} 
${if(len(部门) == 0,"","and 部门 = '" + 部门 + "'")} 
GROUP BY 科目大类, 科目类别, 预算年份, 部门]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="公司预算花费比例" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="预算年份"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=year(today())]]></Attributes>
</O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT cast(SUM(实际费用)/SUM(预算费用)as decimal(15,4)) AS 费用使用情况 FROM (
SELECT T1.* ,T2.预算年份,T2.部门 FROM FD_费用预算明细  T1,
(SELECT * FROM FD_费用预算流转表 T1 WHERE 预算年份='${预算年份}' AND 状态 IN("结束"))T2
WHERE T1.预算流程ID=T2.预算流程ID)TT]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="部门预算花费比例前四个" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="预算年份"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=YEAR(TODAY())]]></Attributes>
</O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 部门, cast(SUM(实际费用) / SUM(预算费用) as decimal(15,4)) AS 费用使用情况 
FROM (
    SELECT T1.实际费用, T1.预算费用, T2.部门 
    FROM FD_费用预算明细 T1
    INNER JOIN (
        SELECT 预算流程ID, 预算年份, 部门 
        FROM FD_费用预算流转表 
        WHERE 预算年份 = '${预算年份}' AND 状态 IN ('结束')
    ) T2 ON T1.预算流程ID = T2.预算流程ID
) TT 
GROUP BY 部门
ORDER BY 部门]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="部门预算花费比例后四个" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="预算年份"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=YEAR(TODAY())]]></Attributes>
</O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 部门, cast(SUM(实际费用) / SUM(预算费用) as decimal(15,4)) AS 费用使用情况 
FROM (
    SELECT T1.实际费用, T1.预算费用, T2.部门 
    FROM FD_费用预算明细 T1
    INNER JOIN (
        SELECT * FROM FD_费用预算流转表 WHERE 预算年份='${预算年份}' AND 状态 = '结束'
    ) T2 ON T1.预算流程ID = T2.预算流程ID
) TT 
GROUP BY 部门
ORDER BY 部门 DESC]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
<TableData name="科目大类" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters>
<Parameter>
<Attributes name="预算年份"/>
<O t="XMLable" class="com.fr.base.Formula">
<Attributes>
<![CDATA[=YEAR(today())]]></Attributes>
</O>
</Parameter>
<Parameter>
<Attributes name="部门"/>
<O>
<![CDATA[]]></O>
</Parameter>
</Parameters>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 科目大类, cast(SUM(实际费用) as decimal(15,4)) AS 实际费用, cast(SUM(预算费用) as decimal(15,4)) AS 预算费用 
FROM (
    SELECT T1.*, T2.预算年份, T2.部门, T3.科目大类 
    FROM FD_费用预算明细 T1, FD_费用科目表 T3,
    (SELECT * FROM FD_费用预算流转表 T1 WHERE 预算年份= '${预算年份}' AND 状态 IN("结束")) T2
    WHERE T1.预算流程ID = T2.预算流程ID AND T3.科目代码 = T1.科目代码
) TT
WHERE 1=1 ${if(len(部门) == 0,"","and 部门 = '" + 部门 + "'")} 
GROUP BY 科目大类]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
