<TableDataMap>
<TableData name="费用明细" class="com.fr.data.impl.DBTableData">
<Desensitizations desensitizeOpen="false"/>
<Parameters/>
<Attributes maxMemRowCount="-1"/>
<Connection class="com.fr.data.impl.NameDatabaseConnection">
<DatabaseName>
<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT 预算年份, SUM(总费用) AS 总费用 
FROM (
    SELECT T1.预算年份, T2.总费用 
    FROM FD_费用预算流转表 T1
    INNER JOIN (
        SELECT 预算流程ID, SUM(预算费用) AS 总费用 
        FROM `FD_费用预算明细` 
        GROUP BY 预算流程ID
    ) T2 ON T1.预算流程ID = T2.预算流程ID
    WHERE T1.状态 = '结束'
) TT 
GROUP BY 预算年份
ORDER BY 预算年份 DESC;]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
</TableDataMap>
