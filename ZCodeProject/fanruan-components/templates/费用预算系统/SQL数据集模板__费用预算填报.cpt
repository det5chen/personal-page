<![CDATA[Mysql数据连接]]></DatabaseName>
</Connection>
<Query>
<![CDATA[SELECT * FROM FD_费用科目表 ORDER BY  科目代码]]></Query>
<PageQuery>
<![CDATA[]]></PageQuery>
</TableData>
